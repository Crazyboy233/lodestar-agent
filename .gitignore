__pycache__/
*.py[cod]
.venv/
.env
config.local.yaml
.workbuddy/
.pytest_cache/
.DS_Store

# worker 的产出不进版本库（保留目录本身）
workspace/*
!workspace/.gitkeep
.verify/

logs/

# LangGraph checkpoint（每次运行的 state，可 --resume 续跑）
checkpoints.sqlite
checkpoints.sqlite-wal
checkpoints.sqlite-shm

# 左侧导航的运行历史（线程 / 产出目录 / 状态），属于本机运行时数据
history.json
history.json.tmp

# 前端依赖：构建产物留在 lodestar_agent/static/（体积不大，直接跑得到）
frontend/node_modules/
frontend/dist/
